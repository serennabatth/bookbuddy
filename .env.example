# Copy this file to .env and fill in the values. Never commit .env.

# A long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# development, testing or production
BOOKBUDDY_ENV=development

# Leave empty to use the local SQLite file in instance/bookbuddy.db.
# In production this will be a PostgreSQL URL.
DATABASE_URL=
